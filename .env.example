# Copia questo file in `.env` per l'esecuzione in locale e riempilo.
# Su GitHub Actions questi valori arrivano invece dai Secrets del repository.
# `.env` è in .gitignore: non finirà mai in un commit.
#
# Caricamento in locale (zsh/bash):
#   set -a && source .env && set +a && python main.py --dry-run

# --- Telegram (obbligatori per ricevere notifiche) -------------------------
# Token restituito da @BotFather alla creazione del bot.
TELEGRAM_BOT_TOKEN=

# Il TUO chat id numerico: è l'unico autorizzato a impartire comandi al bot.
# Per ottenerlo: scrivi un messaggio qualsiasi al bot, poi apri
# https://api.telegram.org/bot<IL_TUO_TOKEN>/getUpdates e leggi message.chat.id
TELEGRAM_CHAT_ID=

# --- Stato persistente (obbligatori su Actions) ----------------------------
# Personal Access Token *classico* con il solo scope `gist`.
# Il GITHUB_TOKEN automatico di Actions NON funziona: non ha quello scope,
# e i token fine-grained non gestiscono affatto i Gist.
GIST_TOKEN=

# Id del Gist privato che contiene lo stato. Lascialo vuoto al primo avvio:
# il monitor ne crea uno e stampa l'id nei log, poi va salvato qui e nei secrets.
GIST_ID=

# --- eBay (opzionali ma consigliati) ---------------------------------------
# Credenziali di produzione da https://developer.ebay.com (account gratuito).
# Senza, eBay funziona comunque tramite parsing HTML, ma senza data di
# pubblicazione affidabile e con più rischio di rottura.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# --- Controllo del trigger esterno (opzionale) -----------------------------
# Permettono a /spegni su Telegram e al pannello nella dashboard di fermare e
# riaccendere il cronjob su cron-job.org, che è ciò che fa partire il monitor.
# La chiave si crea su cron-job.org -> Settings -> API -> Create API key.
# L'id del job è il numero nell'URL quando lo apri (console.cron-job.org/jobs/<id>).
CRONJOB_API_KEY=
CRONJOB_JOB_ID=

# --- Solo per test in locale dei comandi del bot ---------------------------
# Su Actions viene fornito automaticamente. Serve a committare config.yaml.
# GITHUB_TOKEN=
# GITHUB_REPOSITORY=tuo-utente/tuo-repo
